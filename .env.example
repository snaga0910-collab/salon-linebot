# （テスト）サロンmina｜秘密の設定ファイル
# このファイルは .gitignore 済み（GitHubには公開されません）
# 「=」の右側に貼り付けてください。クォート（" '）は不要です。

# --- LINE（LINE Developers → hair salon mina のチャネル） ---
# ① チャネル基本設定タブ →「チャネルシークレット」
LINE_CHANNEL_SECRET=

# ② Messaging API設定タブ →「チャネルアクセストークン（長期）」
LINE_CHANNEL_ACCESS_TOKEN=

# ③ チャネル基本設定タブ → 一番下「あなたのユーザーID」（U で始まる文字列）
#    ＝ オーナー（佐藤様役）への通知先
OWNER_LINE_USER_ID=

# --- Supabase（そろそろリマインダーと同じプロジェクトを使います／設定済み） ---
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SECRET_KEY=

# --- 毎朝の通知を保護する合言葉（自動生成済み・触らなくてOK） ---
CRON_SECRET=
